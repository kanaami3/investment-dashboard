# Copy this file to `.streamlit/secrets.toml` for local development.
# On Streamlit Cloud, paste the contents into the app's Settings → Secrets UI.
# DO NOT commit the real `secrets.toml` — it is gitignored.

# Password required to view the dashboard.  Pick a long, random string.
# Generate one with e.g.:  python -c "import secrets; print(secrets.token_urlsafe(24))"
app_password = "REPLACE_WITH_A_LONG_RANDOM_STRING"
